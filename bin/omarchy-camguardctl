#!/usr/bin/env python3
"""Control and inspect the local Omarchy CamGuard service."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any


HOME = Path.home()
CONFIG_PATH = HOME / ".config" / "omarchy-camguard" / "config.json"
STATUS_PATH = HOME / ".local" / "state" / "omarchy-camguard" / "status.json"
SESSION_PATH = HOME / ".local" / "state" / "omarchy-camguard" / "active-session.json"
DEFAULT_PHOTO_DIR = HOME / "Pictures" / "CamGuard"
RUNTIME_DIR = Path(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
) / "omarchy-camguard"
LOCK_STATE_PATH = RUNTIME_DIR / "lock-state.json"
TRIGGER_PREFIXES = {
    "opening_computer_case-": "lid",
    "key_pressed-": "keyboard",
    "trackpad_touched-": "trackpad",
    "mouse_moved-": "mouse",
}


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def write_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, indent=2, sort_keys=True)
            stream.write("\n")
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def service_active() -> bool:
    return (
        subprocess.run(
            ["systemctl", "is-active", "--quiet", "omarchy-camguard.service"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode
        == 0
    )


def photo_directory() -> Path:
    configured = read_json(CONFIG_PATH).get("photoDirectory", DEFAULT_PHOTO_DIR)
    return Path(configured).expanduser()


def stored_photos() -> list[Path]:
    root = photo_directory()
    if not root.exists():
        return []
    photos = [
        path
        for path in root.rglob("*")
        if path.is_file() and path.suffix.lower() in {".png", ".jpg", ".jpeg"}
    ]
    try:
        photos.sort(key=lambda path: path.stat().st_mtime, reverse=True)
    except OSError:
        photos = [path for path in photos if path.exists()]
    return photos


def trigger_from_photo(photo: Path) -> str:
    for prefix, trigger in TRIGGER_PREFIXES.items():
        if photo.name.startswith(prefix):
            return trigger
    return ""


def status() -> dict[str, Any]:
    config = read_json(CONFIG_PATH)
    value = {
        "serviceActive": service_active(),
        "enabled": bool(config.get("enabled", True)),
        "locked": False,
        "capturing": False,
        "photoCount": 0,
        "lastPhoto": "",
        "lastError": "",
        "updatedAt": "",
    }
    value.update(read_json(STATUS_PATH))
    value["serviceActive"] = service_active()
    value["enabled"] = bool(config.get("enabled", value["enabled"]))
    photos = stored_photos()
    recent_cutoff = time.time() - 300
    recent = []
    for photo in photos:
        try:
            if photo.stat().st_mtime >= recent_cutoff:
                recent.append(str(photo))
        except OSError:
            continue
        if len(recent) == 3:
            break
    value["photoCount"] = len(photos)
    value["lastPhoto"] = str(photos[0]) if photos else ""
    value["lastTrigger"] = trigger_from_photo(photos[0]) if photos else ""
    try:
        value["lastTriggerAt"] = photos[0].stat().st_mtime if photos else 0
    except OSError:
        value["lastTriggerAt"] = 0
    value["recentPhotos"] = recent
    value["hasRecentPhotos"] = bool(recent)
    return value


def set_enabled(enabled: bool) -> None:
    config = read_json(CONFIG_PATH)
    config["enabled"] = enabled
    config.setdefault("camera", "/dev/video0")
    config.setdefault("resolution", "1280x720")
    config.setdefault("intervalSeconds", 5)
    config.setdefault("retentionSeconds", 86400)
    config.setdefault("photoDirectory", str(DEFAULT_PHOTO_DIR))
    write_json(CONFIG_PATH, config)


def delete_photos() -> int:
    root = photo_directory()
    deleted = 0
    for photo in stored_photos():
        try:
            photo.unlink()
            deleted += 1
        except OSError:
            continue
    if root.exists():
        directories = sorted(
            (path for path in root.rglob("*") if path.is_dir()),
            key=lambda path: len(path.parts),
            reverse=True,
        )
        for directory in directories:
            try:
                directory.rmdir()
            except OSError:
                pass
    session = read_json(SESSION_PATH)
    if session:
        session["photos"] = []
        write_json(SESSION_PATH, session)
    return deleted


def publish_lock_state(locked: bool) -> None:
    previous = read_json(LOCK_STATE_PATH)
    try:
        generation = int(previous.get("generation", 0))
    except (TypeError, ValueError):
        generation = 0
    if previous.get("locked") is not locked:
        generation += 1
    write_json(
        LOCK_STATE_PATH,
        {
            "version": 1,
            "locked": locked,
            "generation": generation,
            "updatedAt": time.time(),
        },
    )


def reveal_photo(value: str) -> bool:
    root = photo_directory().resolve()
    try:
        photo = Path(value).expanduser().resolve(strict=True)
        photo.relative_to(root)
    except (OSError, ValueError):
        return False
    if not photo.is_file():
        return False
    subprocess.Popen(
        ["xdg-open", str(photo)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return True


def usage() -> int:
    print(
        "usage: omarchy-camguardctl status|enable|disable|toggle|open|delete"
        "|reveal <photo>|lock-state <true|false>",
        file=sys.stderr,
    )
    return 2


def main() -> int:
    if len(sys.argv) < 2:
        return usage()
    command = sys.argv[1]

    if command == "reveal":
        if len(sys.argv) != 3:
            return usage()
        return 0 if reveal_photo(sys.argv[2]) else 1
    if command == "lock-state":
        if len(sys.argv) != 3 or sys.argv[2] not in {"true", "false"}:
            return usage()
        publish_lock_state(sys.argv[2] == "true")
        return 0
    if len(sys.argv) != 2:
        return usage()
    if command == "status":
        print(json.dumps(status(), separators=(",", ":"), sort_keys=True))
        return 0
    if command == "enable":
        set_enabled(True)
        return 0
    if command == "disable":
        set_enabled(False)
        return 0
    if command == "toggle":
        set_enabled(not bool(read_json(CONFIG_PATH).get("enabled", True)))
        return 0
    if command == "open":
        directory = photo_directory()
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        subprocess.Popen(
            ["xdg-open", str(directory)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return 0
    if command == "delete":
        print(delete_photos())
        return 0
    return usage()


if __name__ == "__main__":
    raise SystemExit(main())
