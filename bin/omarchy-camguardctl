#!/usr/bin/env python3
"""Control and inspect the local Omarchy CamGuard service."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any


HOME = Path.home()
CONFIG_PATH = HOME / ".config" / "omarchy-camguard" / "config.json"
STATUS_PATH = HOME / ".local" / "state" / "omarchy-camguard" / "status.json"
SESSION_PATH = HOME / ".local" / "state" / "omarchy-camguard" / "active-session.json"
DEFAULT_PHOTO_DIR = HOME / "Pictures" / "CamGuard"
PLUGIN_DIR = HOME / ".config" / "omarchy" / "plugins" / "austraz.camguard"
UPDATE_SERVICE_SYSTEM = PLUGIN_DIR / "update-service-system.sh"
RUNTIME_DIR = Path(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
) / "omarchy-camguard"
LOCK_STATE_PATH = RUNTIME_DIR / "lock-state.json"
TRIGGER_PREFIXES = {
    "opening_computer_case-": "lid",
    "key_pressed-": "keyboard",
    "trackpad_touched-": "trackpad",
    "mouse_moved-": "mouse",
}


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def write_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, indent=2, sort_keys=True)
            stream.write("\n")
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def service_active() -> bool:
    return (
        subprocess.run(
            ["systemctl", "is-active", "--quiet", "omarchy-camguard.service"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode
        == 0
    )


def photo_directory() -> Path:
    configured = read_json(CONFIG_PATH).get("photoDirectory", DEFAULT_PHOTO_DIR)
    return Path(str(configured)).expanduser()


def resolve_photo_directory(value: str | Path) -> Path:
    raw = Path(str(value)).expanduser()
    if not raw.is_absolute():
        raw = HOME / raw
    resolved = raw.resolve()
    home = HOME.resolve()
    try:
        resolved.relative_to(home)
    except ValueError as error:
        raise ValueError("Photo directory must stay under your home directory") from error
    return resolved


def uri_to_path(value: str) -> Path:
    text = str(value).strip()
    if text.startswith("file://"):
        from urllib.parse import unquote, urlparse

        parsed = urlparse(text)
        if parsed.scheme != "file":
            raise ValueError("Unsupported folder URI")
        text = unquote(parsed.path)
    return Path(text)


def stored_photos() -> list[Path]:
    root = photo_directory()
    if not root.exists():
        return []
    photos = [
        path
        for path in root.rglob("*")
        if path.is_file() and path.suffix.lower() in {".png", ".jpg", ".jpeg"}
    ]
    try:
        photos.sort(key=lambda path: path.stat().st_mtime, reverse=True)
    except OSError:
        photos = [path for path in photos if path.exists()]
    return photos


def trigger_from_photo(photo: Path) -> str:
    for prefix, trigger in TRIGGER_PREFIXES.items():
        if photo.name.startswith(prefix):
            return trigger
    return ""


def status() -> dict[str, Any]:
    config = read_json(CONFIG_PATH)
    value = {
        "serviceActive": service_active(),
        "enabled": bool(config.get("enabled", True)),
        "locked": False,
        "capturing": False,
        "photoCount": 0,
        "lastPhoto": "",
        "lastError": "",
        "updatedAt": "",
    }
    value.update(read_json(STATUS_PATH))
    value["serviceActive"] = service_active()
    value["enabled"] = bool(config.get("enabled", value["enabled"]))
    photos = stored_photos()
    recent_cutoff = time.time() - 300
    recent = []
    for photo in photos:
        try:
            if photo.stat().st_mtime >= recent_cutoff:
                recent.append(str(photo))
        except OSError:
            continue
        if len(recent) == 3:
            break
    value["photoCount"] = len(photos)
    value["lastPhoto"] = str(photos[0]) if photos else ""
    value["lastTrigger"] = trigger_from_photo(photos[0]) if photos else ""
    try:
        value["lastTriggerAt"] = photos[0].stat().st_mtime if photos else 0
    except OSError:
        value["lastTriggerAt"] = 0
    value["recentPhotos"] = recent
    value["hasRecentPhotos"] = bool(recent)
    value["photoDirectory"] = str(photo_directory())
    return value


def ensure_config_defaults(config: dict[str, Any]) -> dict[str, Any]:
    config.setdefault("camera", "/dev/video0")
    config.setdefault("resolution", "1280x720")
    config.setdefault("intervalSeconds", 5)
    config.setdefault("retentionSeconds", 86400)
    config.setdefault("photoDirectory", str(DEFAULT_PHOTO_DIR))
    config.setdefault("enabled", True)
    return config


def set_enabled(enabled: bool) -> None:
    config = ensure_config_defaults(read_json(CONFIG_PATH))
    config["enabled"] = enabled
    write_json(CONFIG_PATH, config)


def refresh_service_photo_path(directory: Path) -> None:
    if not UPDATE_SERVICE_SYSTEM.is_file():
        raise RuntimeError("CamGuard update helper is missing. Reinstall the plugin.")
    user_name = os.environ.get("USER") or os.environ.get("LOGNAME") or Path.home().name
    user_group = subprocess.check_output(["id", "-gn"], text=True).strip()
    user_uid = str(os.getuid())
    result = subprocess.run(
        [
            "pkexec",
            str(UPDATE_SERVICE_SYSTEM),
            user_name,
            user_group,
            user_uid,
            str(HOME),
            str(directory),
        ],
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError("Failed to update the CamGuard service write path")


def set_photo_directory(value: str | Path, *, update_service: bool = True) -> Path:
    directory = resolve_photo_directory(value)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(directory, 0o700)
    config = ensure_config_defaults(read_json(CONFIG_PATH))
    previous = resolve_photo_directory(config.get("photoDirectory", DEFAULT_PHOTO_DIR))
    config["photoDirectory"] = str(directory)
    write_json(CONFIG_PATH, config)
    if update_service and directory != previous:
        refresh_service_photo_path(directory)
    return directory


def choose_photo_directory() -> Path | None:
    command = [
        "omarchy-file-select",
        "--directory",
        "--title",
        "CamGuard photo directory",
    ]
    result = subprocess.run(command, check=False, capture_output=True, text=True)
    if result.returncode == 1:
        return None
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"Folder chooser failed: {detail}")
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if not lines:
        return None
    return set_photo_directory(uri_to_path(lines[0]))


def delete_photos() -> int:
    root = photo_directory()
    deleted = 0
    for photo in stored_photos():
        try:
            photo.unlink()
            deleted += 1
        except OSError:
            continue
    if root.exists():
        directories = sorted(
            (path for path in root.rglob("*") if path.is_dir()),
            key=lambda path: len(path.parts),
            reverse=True,
        )
        for directory in directories:
            try:
                directory.rmdir()
            except OSError:
                pass
    session = read_json(SESSION_PATH)
    if session:
        session["photos"] = []
        write_json(SESSION_PATH, session)
    return deleted


def publish_lock_state(locked: bool) -> None:
    previous = read_json(LOCK_STATE_PATH)
    try:
        generation = int(previous.get("generation", 0))
    except (TypeError, ValueError):
        generation = 0
    if previous.get("locked") is not locked:
        generation += 1
    write_json(
        LOCK_STATE_PATH,
        {
            "version": 1,
            "locked": locked,
            "generation": generation,
            "updatedAt": time.time(),
        },
    )


def reveal_photo(value: str) -> bool:
    root = photo_directory().resolve()
    try:
        photo = Path(value).expanduser().resolve(strict=True)
        photo.relative_to(root)
    except (OSError, ValueError):
        return False
    if not photo.is_file():
        return False
    subprocess.Popen(
        ["xdg-open", str(photo)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return True


def usage() -> int:
    print(
        "usage: omarchy-camguardctl status|enable|disable|toggle|open|delete"
        "|choose-directory|set-directory <path>|reveal <photo>|lock-state <true|false>",
        file=sys.stderr,
    )
    return 2


def main() -> int:
    if len(sys.argv) < 2:
        return usage()
    command = sys.argv[1]

    if command == "reveal":
        if len(sys.argv) != 3:
            return usage()
        return 0 if reveal_photo(sys.argv[2]) else 1
    if command == "lock-state":
        if len(sys.argv) != 3 or sys.argv[2] not in {"true", "false"}:
            return usage()
        publish_lock_state(sys.argv[2] == "true")
        return 0
    if command == "set-directory":
        if len(sys.argv) != 3:
            return usage()
        try:
            print(set_photo_directory(sys.argv[2]))
        except (OSError, RuntimeError, ValueError) as error:
            print(error, file=sys.stderr)
            return 1
        return 0
    if command == "choose-directory":
        if len(sys.argv) != 2:
            return usage()
        try:
            chosen = choose_photo_directory()
        except (OSError, RuntimeError, ValueError) as error:
            print(error, file=sys.stderr)
            return 1
        if chosen is None:
            return 0
        print(chosen)
        return 0
    if len(sys.argv) != 2:
        return usage()
    if command == "status":
        print(json.dumps(status(), separators=(",", ":"), sort_keys=True))
        return 0
    if command == "enable":
        set_enabled(True)
        return 0
    if command == "disable":
        set_enabled(False)
        return 0
    if command == "toggle":
        set_enabled(not bool(read_json(CONFIG_PATH).get("enabled", True)))
        return 0
    if command == "open":
        directory = photo_directory()
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        subprocess.Popen(
            ["xdg-open", str(directory)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return 0
    if command == "delete":
        print(delete_photos())
        return 0
    return usage()


if __name__ == "__main__":
    raise SystemExit(main())
